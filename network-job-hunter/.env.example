# Copier ce fichier en .env et remplir les valeurs reelles. Ne jamais committer .env.

# API France Travail (https://francetravail.io -> creer une application)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# SDK Anthropic (optimisation ATS)
ANTHROPIC_API_KEY=

# Envoi des candidatures par email (ex: Gmail avec mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=Wesley Amavi
SENDER_EMAIL=

# Chemin de la base SQLite de suivi des candidatures
DATABASE_PATH=data/app.db
